{
  "name": "trading-pwa-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "backtest": "tsx --tsconfig backtest/tsconfig.json backtest/index.ts",
    "backtest:harmonic-audit": "tsx --tsconfig backtest/tsconfig.json backtest/harmonic-audit.ts",
    "backtest:htf-resample-audit": "tsx --tsconfig backtest/tsconfig.json backtest/htf-resample-stability-audit.ts",
    "backtest:horizon-audit": "tsx --tsconfig backtest/tsconfig.json backtest/horizon-audit.ts",
    "backtest:gen-horizon-table": "tsx --tsconfig backtest/tsconfig.json backtest/generate-pattern-horizon-table.ts",
    "backtest:gen-horizon-table:check": "tsx --tsconfig backtest/tsconfig.json backtest/generate-pattern-horizon-table.ts --check",
    "backtest:gen-horizon-table:check:strict": "tsx --tsconfig backtest/tsconfig.json backtest/generate-pattern-horizon-table.ts --check --strict",
    "backtest:null-audit": "tsx --tsconfig backtest/tsconfig.json backtest/null-audit.ts",
    "backtest:microstructure-audit": "tsx --tsconfig backtest/tsconfig.json backtest/microstructure-audit.ts",
    "backtest:continuation-audit": "tsx --tsconfig backtest/tsconfig.json backtest/continuation-audit.ts",
    "backtest:forward-test": "tsx --tsconfig backtest/tsconfig.json backtest/forward-test.ts",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run backtest:gen-horizon-table:check"
  },
  "dependencies": {
    "@sentry/react": "^8.47.0",
    "@supabase/supabase-js": "^2.112.0",
    "lightweight-charts": "^5.0.5",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.6"
  }
}
