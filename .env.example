# Supabase URL and anon key (required for edge function proxies and data persistence)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deriv WebSocket app_id (default: 1089 — Deriv's public demo app_id).
# Create your own at https://api.deriv.com/dashboard for production use.
VITE_DERIV_APP_ID=1089

# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=

# Yahoo Finance CORS proxy URL (required for Yahoo source)
VITE_YAHOO_PROXY_URL=
